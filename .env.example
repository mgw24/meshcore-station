# Generated by scripts/configure.sh. NEVER commit .env.
POSTGRES_USER=meshcore
POSTGRES_DB=meshcore
POSTGRES_PASSWORD=REPLACE
GRAFANA_DB_PASSWORD=REPLACE
GRAFANA_ADMIN_PASSWORD=REPLACE
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SALT=REPLACE
ADMIN_PASSWORD_HASH=REPLACE
SESSION_SECRET=REPLACE
# Bind to your VM's VPN-reachable private IPv4, not public Internet.
BIND_IP=127.0.0.1
APP_PORT=8088
GRAFANA_PORT=3300
RADIO_DEVICE=/dev/ttyACM0
# Set usb for a permanent USB-powered board without a battery
RADIO_POWER_SOURCE=usb
COOKIE_SECURE=false
# Optional mail alerts (requires SMTP config)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=

# Email digest SMTP password encryption. Generated locally with scripts/enable-digests.sh.
# Do not commit a real value; keep a protected backup of this key.
DIGEST_ENCRYPTION_KEY=
DIGEST_POLL_SECONDS=30
